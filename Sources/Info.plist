<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Suber</string>
	<key>CFBundleDisplayName</key>
	<string>Suber</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSUIElement</key>
	<true/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.finance</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>ATSApplicationFontsPath</key>
	<string>.</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.suber.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>suber</string>
			</array>
		</dict>
	</array>
	<!-- v1.6.0 Mail Watchdog: user-facing string shown in the macOS TCC permission
	     prompt when Suber first asks to control Mail. Keep it specific and honest;
	     the in-app consent modal does the heavier trust-scaffolding before this fires. -->
	<key>NSAppleEventsUsageDescription</key>
	<string>Suber reads billing receipts from Apple Mail so you never miss a price change or a subscription you forgot about. Only renewal and invoice emails are read. Nothing leaves your Mac.</string>
</dict>
</plist>
