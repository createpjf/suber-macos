    "Price changes" : {
      "comment" : "Settings Autopilot alert toggle label.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "涨价提醒"
          }
        }
      }
    },

    "e.g. Netflix raised from $15.99 to $22.99" : {
      "comment" : "Settings Autopilot price-change toggle sublabel.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "例如:Netflix 从 $15.99 涨到 $22.99"
