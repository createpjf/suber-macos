{
  "sourceLanguage" : "en",
  "version" : "1.0",
  "strings" : {

    "Let Suber watch Apple Mail for billing receipts" : {
      "comment" : "Consent modal title (D9). Highest-stakes copy in v1.6 — shown before macOS TCC prompt.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让 Suber 监听 Apple Mail 的账单邮件"
          }
        }
      }
    },

    "So you never miss a price rise, a new sub, or a duplicate charge." : {
      "comment" : "Consent modal subtitle.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这样你就不会错过涨价、新订阅或重复扣款。"
          }
        }
      }
    },

    "Only reads receipts" : {
      "comment" : "Consent modal trust bullet 1 title.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只读账单邮件"
          }
        }
      }
    },

    "Renewals, invoices, trial endings. Suber ignores everything else." : {
      "comment" : "Consent modal trust bullet 1 body.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "续费、发票、试用到期。其他邮件 Suber 一概不看。"
          }
        }
      }
    },

    "Stays on this Mac" : {
      "comment" : "Consent modal trust bullet 2 title.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只留在这台 Mac 上"
          }
        }
      }
    },

    "Amounts and dates are saved. Nothing leaves your machine." : {
      "comment" : "Consent modal trust bullet 2 body.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只保存金额和日期。任何内容都不会离开你的电脑。"
          }
        }
      }
    },

    "Turn off any time" : {
      "comment" : "Consent modal trust bullet 3 title.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "随时可关闭"
          }
        }
      }
    },

    "Settings → Autopilot. Or revoke in System Settings → Privacy → Automation." : {
      "comment" : "Consent modal trust bullet 3 body.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「设置 → Autopilot」里关闭,或在「系统设置 → 隐私与安全性 → 自动化」中撤销授权。"
          }
        }
      }
    },

    "Next, macOS will ask you to allow Suber to control Mail. Click OK in that dialog to continue." : {
      "comment" : "Consent modal footnote priming the TCC prompt.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接下来,macOS 会弹出一个对话框,询问是否允许 Suber 控制 Mail。点击「好」继续。"
          }
        }
      }
    },

    "Connect Apple Mail" : {
      "comment" : "Consent modal primary button.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接 Apple Mail"
          }
        }
      }
    },

    "Cancel" : {
      "comment" : "Generic cancel button.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取消"
          }
        }
      }
    },

    "Not now" : {
      "comment" : "Cancel confirmation sheet secondary button (D10).",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂不"
          }
        }
