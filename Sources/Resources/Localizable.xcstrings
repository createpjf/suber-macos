    "Fastmail App Passwords" : {
      "comment" : "Fastmail quick link button.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contraseñas de aplicación de Fastmail"
          }
        },
        "es-419" : {
