    "Reads billing receipts (renewals, invoices, trials) once a day. Nothing is stored except amounts and dates." : {
      "comment" : "Settings Autopilot watch-toggle helper text.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天扫描一次账单邮件(续费、发票、试用)。只保存金额和日期,不保存其他内容。"
          }
        }
      }
    },

    "Scan now" : {
      "comment" : "Settings Autopilot manual scan button.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "立即扫描"
