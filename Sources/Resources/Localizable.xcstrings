        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为安全起见推荐开启 —— Suber 会保留一份可随时恢复的远程副本。"
          }
        }
      }
    },
    "Stays in sync across all your Macs" : {
