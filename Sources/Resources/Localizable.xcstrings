      }
    },
    "Recommended for safety — Suber can keep a remote copy you can restore from." : {
      "comment" : "iCloud onboarding subtitle.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recomendado por seguridad: Suber puede guardar una copia remota desde la que restaurar tus datos."
          }
        },
